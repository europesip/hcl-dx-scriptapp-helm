# Copy to .env.local (ignored by git) for "npm run dev" and "npm run dx-deploy" from your workstation.
# The Helm chart does NOT use this file: there, the values come from values.yaml and a Secret.

# --- npm run dev: local proxy to DX (log in at http://localhost:3000/wps/portal first) ---
DX_TARGET=https://dx.example.com/wps/portal

# --- npm run dx-deploy: DXClient push from your workstation ---
DX_USERNAME=
DX_PASSWORD=
DX_CONTENT_HANDLER_PATH=/wps/mycontenthandler
DX_MAIN_HTML_FILE=index.html
DX_SITE_AREA=Script Application Library/Script Applications/
DX_CONTENT_NAME=europesip-hello-dx
DX_CONTENT_TITLE=Hello DX
DX_CONTENT_ROOT=./dist
